# Biến cho bản deploy. Sao chép thành .env.production (không commit) rồi chạy: npm run build
# Địa chỉ backend đã deploy (kết thúc bằng /api)
VITE_API_URL=https://ten-backend.onrender.com/api
VITE_USE_EMULATOR=false
VITE_USE_AUTH_EMULATOR=false
VITE_USE_MOCK=false
# Lấy ở Firebase Console → Project settings → Your apps → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ticketrush-5a616.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ticketrush-5a616
