# Để trống VITE_API_URL khi dùng proxy của Vite (/api -> localhost:4000)
VITE_API_URL=
# Firestore Emulator (dữ liệu seed) – true khi dev
VITE_USE_EMULATOR=true
# Auth Emulator (popup Google giả lập). Đặt false + điền VITE_FIREBASE_* thật để đăng nhập bằng tài khoản Google thật
VITE_USE_AUTH_EMULATOR=true
# true: API nào backend chưa làm (501) hoặc backend không chạy thì dùng dữ liệu mẫu trong src/api/mock.js
VITE_USE_MOCK=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=ticketrush-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ticketrush-dev
