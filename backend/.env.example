PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (khớp docker-compose.yml)
DATABASE_URL=postgres://ticketrush:ticketrush@localhost:5433/ticketrush

# Auth
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai
JWT_EXPIRES_IN=8h

# Firebase – dev dùng Emulator (không cần serviceAccount.json)
FIREBASE_PROJECT_ID=ticketrush-dev
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json   # chỉ khi dùng Firebase thật, KHÔNG commit

# Nghiệp vụ / Lab
SEAT_HOLD_MINUTES=10
LAB_RESULTS_DIR=./lab-results
# Backup lab: dùng bộ công cụ cùng major version với server.
# Với docker-compose.yml của dự án, dùng công cụ ngay trong container PostgreSQL 16:
PG_TOOLS_CONTAINER=ticketrush-postgres
# Nếu DATABASE_URL trỏ đến server khác: bỏ PG_TOOLS_CONTAINER, dùng client đúng phiên bản trên PATH
# hoặc đặt PG_DUMP_PATH / PG_RESTORE_PATH tới executable local tương ứng.
